+interface ParsedLaunchdProgram {
+  shellExecutable: string;
+  shellCommand: string;
+}
+
+function parseLaunchdProgramArguments(
+  arguments_: readonly string[] | undefined,
+  environment: Readonly<Record<string, string>>,
+): ParsedLaunchdProgram | undefined {
+  if (arguments_?.length === 4 && arguments_[0] === "/usr/bin/env" && arguments_[2] === "-lc") {
+    return { shellExecutable: arguments_[1] ?? "", shellCommand: arguments_[3] ?? "" };
+  }
+
+  const homeManagerPrefix = "/bin/wait4path /nix/store && exec ";
+  const homeManagerCommand = arguments_?.length === 3
+    && arguments_[0] === "/bin/sh"
+    && arguments_[1] === "-c"
+    && arguments_[2]?.startsWith(homeManagerPrefix) === true
+    ? arguments_[2].slice(homeManagerPrefix.length)
+    : undefined;
+  const homeManagerShell = ownEnvironmentValue(environment, "SHELL");
+  if (homeManagerCommand === undefined || homeManagerCommand === "" || homeManagerShell === undefined) return undefined;
+  return { shellExecutable: homeManagerShell, shellCommand: homeManagerCommand };
+}
