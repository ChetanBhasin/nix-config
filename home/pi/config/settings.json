{
  "defaultModel": "gpt-5.6-sol",
  "defaultProjectTrust": "ask",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai-codex/gpt-5.6-luna:low",
    "openai-codex/gpt-5.6-terra:high",
    "openai-codex/gpt-5.6-sol:max"
  ],
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "auto",
  "markdown": {
    "mermaid": "streaming"
  },
  "packages": [
    "npm:@narumitw/pi-accounts@0.49.10",
    "npm:@howaboua/pi-codex-conversion@3.0.23",
    "npm:@narumitw/pi-usage@0.52.2",
    "npm:@juicesharp/rpiv-ask-user-question@2.7.1",
    "npm:@juicesharp/rpiv-todo@2.7.1",
    "npm:@narumitw/pi-btw@0.55.3",
    "npm:pi-lens@4.1.2",
    "npm:pi-hashline-edit-pro@2.7.2",
    "npm:pi-agent-browser-native@0.5.0",
    "npm:pi-subagents@0.56.0",
    "npm:@cortexkit/pi-magic-context@0.40.0",
    "npm:@earendil-works/pi-tui@0.84.3",
    "npm:pi-footer@0.5.1",
    "./extensions/auto-mode",
    "./extensions/settings-hub",
    "./extensions/session-coordinator"
  ],
  "quietStartup": true,
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "acceptanceRole": "read-only",
        "defaultContext": "fresh",
        "description": "Small fresh-context delegate; read-only unless explicitly rerouted to worker",
        "extensions": [
          "~/.pi/agent/npm/node_modules/@narumitw/pi-accounts/dist/index.ts",
          "~/.pi/agent/npm/node_modules/pi-lens/dist/index.js"
        ],
        "inheritProjectContext": true,
        "inheritSkills": false,
        "model": "inherit",
        "output": "delegate.md",
        "outputMode": "file-only",
        "subagentOnlyExtensions": [
          "~/.pi/agent/extensions/auto-mode/index.ts"
        ],
        "systemPromptMode": "append",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "lens_diagnostics",
          "lsp_diagnostics",
          "project_report",
          "module_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search",
          "pi_lens_activate_tools",
          "ast_grep_search",
          "ast_grep_outline",
          "ast_grep_dump",
          "lsp_navigation"
        ]
      },
      "oracle": {
        "acceptanceRole": "read-only",
        "defaultContext": "fresh",
        "description": "Deep decision challenger; use context=fork only when conversation history is evidence",
        "extensions": [
          "~/.pi/agent/npm/node_modules/@narumitw/pi-accounts/dist/index.ts",
          "~/.pi/agent/npm/node_modules/pi-lens/dist/index.js"
        ],
        "inheritProjectContext": true,
        "inheritSkills": false,
        "model": "openai-codex/gpt-5.6-sol",
        "output": "oracle.md",
        "outputMode": "file-only",
        "subagentOnlyExtensions": [
          "~/.pi/agent/extensions/auto-mode/index.ts"
        ],
        "systemPrompt": "You are the oracle, a read-only decision-consistency challenger. In a fresh context, treat the supplied task and evidence as authoritative; do not presume inherited conversation decisions. Only when the context is actually forked or those decisions are explicitly supplied, reconstruct inherited conversation decisions and test them against the available evidence. Inspect only scoped sources needed to evaluate the decision. Return narrow, actionable recommendations with concise evidence and residual uncertainty; do not implement changes. Escalate to the supervisor only through the runtime bridge and only for material unknowns that scoped source inspection and supplied evidence cannot resolve. Keep the output concise.",
        "systemPromptMode": "append",
        "thinking": "max",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "lens_diagnostics",
          "lsp_diagnostics",
          "project_report",
          "module_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search",
          "pi_lens_activate_tools",
          "ast_grep_search",
          "ast_grep_outline",
          "ast_grep_dump",
          "lsp_navigation"
        ]
      },
      "researcher": {
        "acceptanceRole": "read-only",
        "defaultContext": "fresh",
        "description": "Stateless one-angle web researcher using Nix-owned Codex discovery",
        "extensions": [
          "~/.pi/agent/npm/node_modules/@narumitw/pi-accounts/dist/index.ts",
          "~/.pi/agent/npm/node_modules/pi-lens/dist/index.js",
          "~/.pi/agent/npm/node_modules/@howaboua/pi-codex-conversion/dist/index.js"
        ],
        "inheritProjectContext": true,
        "inheritSkills": false,
        "model": "openai-codex/gpt-5.6-terra",
        "output": "research.md",
        "outputMode": "file-only",
        "subagentOnlyExtensions": [
          "~/.pi/agent/extensions/auto-mode/index.ts"
        ],
        "systemPrompt": "You are the researcher, a stateless one-angle web evidence specialist. Work only the assigned research angle. Use only `read` for provided local evidence and `web_run`; when search is needed, batch 2–4 high-signal `search_query` entries in one `web_run` call. Prioritize primary sources, open the most relevant primary sources with `web_run`, and cite final source URLs for every material claim. After one setup, native-helper, or provider failure, stop and report the failure; do not retry or fall back. Never use browser, shell, curl, or search-engine form automation. Return compact evidence: conclusion, final URLs, key support, and unresolved gap. Do not modify files, settings, code, or runtime state.",
        "systemPromptMode": "append",
        "thinking": "max",
        "tools": [
          "read",
          "web_run"
        ]
      },
      "reviewer": {
        "acceptanceRole": "read-only",
        "defaultContext": "fresh",
        "description": "Independent fresh-context reviewer with no mutation surface",
        "extensions": [
          "~/.pi/agent/npm/node_modules/@narumitw/pi-accounts/dist/index.ts",
          "~/.pi/agent/npm/node_modules/pi-lens/dist/index.js"
        ],
        "inheritProjectContext": true,
        "inheritSkills": false,
        "model": "openai-codex/gpt-5.6-sol",
        "output": "review.md",
        "outputMode": "file-only",
        "subagentOnlyExtensions": [
          "~/.pi/agent/extensions/auto-mode/index.ts"
        ],
        "systemPromptMode": "append",
        "thinking": "xhigh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "lens_diagnostics",
          "lsp_diagnostics",
          "project_report",
          "module_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search",
          "pi_lens_activate_tools",
          "ast_grep_search",
          "ast_grep_outline",
          "ast_grep_dump",
          "lsp_navigation"
        ]
      },
      "scout": {
        "acceptanceRole": "read-only",
        "defaultContext": "fresh",
        "description": "Fast fresh-context codebase reconnaissance through the Lens discovery funnel",
        "extensions": [
          "~/.pi/agent/npm/node_modules/@narumitw/pi-accounts/dist/index.ts",
          "~/.pi/agent/npm/node_modules/pi-lens/dist/index.js"
        ],
        "inheritProjectContext": true,
        "inheritSkills": false,
        "model": "openai-codex/gpt-5.6-luna",
        "output": "context.md",
        "outputMode": "file-only",
        "subagentOnlyExtensions": [
          "~/.pi/agent/extensions/auto-mode/index.ts"
        ],
        "systemPromptMode": "append",
        "thinking": "low",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "lens_diagnostics",
          "lsp_diagnostics",
          "project_report",
          "module_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search",
          "pi_lens_activate_tools",
          "ast_grep_search",
          "ast_grep_outline",
          "ast_grep_dump",
          "lsp_navigation"
        ]
      },
      "worker": {
        "acceptanceRole": "writer",
        "defaultContext": "fresh",
        "description": "The only writing role; Hashline mutations followed by explicit Lens diagnostics",
        "extensions": [
          "~/.pi/agent/npm/node_modules/@narumitw/pi-accounts/dist/index.ts",
          "~/.pi/agent/npm/node_modules/pi-lens/dist/index.js",
          "~/.pi/agent/npm/node_modules/pi-hashline-edit-pro/index.ts"
        ],
        "inheritProjectContext": true,
        "inheritSkills": false,
        "model": "openai-codex/gpt-5.6-terra",
        "output": "implementation.md",
        "outputMode": "file-only",
        "subagentOnlyExtensions": [
          "~/.pi/agent/extensions/auto-mode/index.ts"
        ],
        "systemPromptMode": "append",
        "thinking": "max",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "replace",
          "insert",
          "undo_last_change",
          "lens_diagnostics",
          "lsp_diagnostics",
          "project_report",
          "module_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search",
          "pi_lens_activate_tools",
          "ast_grep_search",
          "ast_grep_outline",
          "ast_grep_dump",
          "lsp_navigation"
        ]
      }
    },
    "defaultExtensions": [
      "~/.pi/agent/npm/node_modules/@narumitw/pi-accounts/dist/index.ts",
      "~/.pi/agent/npm/node_modules/pi-lens/dist/index.js",
      "~/.pi/agent/extensions/auto-mode/index.ts"
    ],
    "defaultModel": "inherit",
    "defaultProvider": "openai-codex",
    "defaultThinking": "medium",
    "modelScope": {
      "agents": {
        "delegate": {
          "allow": [
            "inherit"
          ]
        },
        "oracle": {
          "allow": [
            "openai-codex/gpt-5.6-sol"
          ]
        },
        "researcher": {
          "allow": [
            "openai-codex/gpt-5.6-terra"
          ]
        },
        "reviewer": {
          "allow": [
            "openai-codex/gpt-5.6-sol"
          ]
        },
        "scout": {
          "allow": [
            "openai-codex/gpt-5.6-luna"
          ]
        },
        "worker": {
          "allow": [
            "openai-codex/gpt-5.6-terra"
          ]
        }
      },
      "allow": [
        "inherit",
        "openai-codex/gpt-5.6-*"
      ],
      "enforce": true,
      "strict": true
    }
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "gruvbox-night",
  "treeFilterMode": "all",
  "tuiMode": "fullscreen"
}
