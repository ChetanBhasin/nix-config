// Luna Comfort: Luna's semantic accents on softened neutral surfaces.
// Accent roles follow luna.nvim (lua/luna/palette.lua), while the neutral
// ladder mirrors modules/theme/luna.nix. Amber is the shared primary accent for
// active tabs, focused frames, selected rows, and other interaction chrome.
themes {
    luna {
        text_unselected {
            base 199 199 199
            background 21 21 21
            emphasis_0 225 144 103
            emphasis_1 117 161 199
            emphasis_2 158 179 142
            emphasis_3 196 168 214
        }
        text_selected {
            base 217 163 90
            background 48 52 58
            emphasis_0 225 144 103
            emphasis_1 117 161 199
            emphasis_2 158 179 142
            emphasis_3 196 168 214
        }
        ribbon_selected {
            base 21 21 21
            background 217 163 90
            emphasis_0 225 144 103
            emphasis_1 194 145 106
            emphasis_2 196 168 214
            emphasis_3 158 179 142
        }
        ribbon_unselected {
            base 199 199 199
            background 35 35 35
            emphasis_0 225 144 103
            emphasis_1 216 216 220
            emphasis_2 117 161 199
            emphasis_3 196 168 214
        }
        table_title {
            base 117 161 199
            background 21 21 21
            emphasis_0 225 144 103
            emphasis_1 194 145 106
            emphasis_2 158 179 142
            emphasis_3 196 168 214
        }
        table_cell_selected {
            base 217 163 90
            background 48 52 58
            emphasis_0 225 144 103
            emphasis_1 117 161 199
            emphasis_2 158 179 142
            emphasis_3 196 168 214
        }
        table_cell_unselected {
            base 199 199 199
            background 21 21 21
            emphasis_0 225 144 103
            emphasis_1 117 161 199
            emphasis_2 158 179 142
            emphasis_3 196 168 214
        }
        list_selected {
            base 217 163 90
            background 48 52 58
            emphasis_0 225 144 103
            emphasis_1 117 161 199
            emphasis_2 158 179 142
            emphasis_3 196 168 214
        }
        list_unselected {
            base 199 199 199
            background 21 21 21
            emphasis_0 225 144 103
            emphasis_1 117 161 199
            emphasis_2 158 179 142
            emphasis_3 196 168 214
        }
        frame_unselected {
            base 69 69 69
            background 21 21 21
            emphasis_0 225 144 103
            emphasis_1 117 161 199
            emphasis_2 196 168 214
            emphasis_3 21 21 21
        }
        frame_selected {
            base 217 163 90
            background 21 21 21
            emphasis_0 225 144 103
            emphasis_1 140 156 184
            emphasis_2 196 168 214
            emphasis_3 21 21 21
        }
        frame_highlight {
            // Hover is one neutral step above the inactive frame; focus stays amber.
            base 104 104 104
            background 21 21 21
            emphasis_0 196 168 214
            emphasis_1 225 144 103
            emphasis_2 194 145 106
            emphasis_3 117 161 199
        }
        exit_code_success {
            base 158 179 142
            background 21 21 21
            emphasis_0 111 190 128
            emphasis_1 48 52 58
            emphasis_2 196 168 214
            emphasis_3 117 161 199
        }
        exit_code_error {
            base 224 133 133
            background 21 21 21
            emphasis_0 194 145 106
            emphasis_1 21 21 21
            emphasis_2 21 21 21
            emphasis_3 21 21 21
        }
        multiplayer_user_colors {
            player_1 196 168 214
            player_2 117 161 199
            player_3 111 190 128
            player_4 194 145 106
            player_5 158 179 142
            player_6 225 144 103
            player_7 224 133 133
            player_8 168 168 168
            player_9 216 216 220
            player_10 176 144 128
        }
    }
}
