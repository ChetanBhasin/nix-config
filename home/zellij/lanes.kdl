layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zjstatus" {
                format_left   "{tabs}"
                format_center ""
                format_right  "#[fg=#d9a35a]{focused_pane_title}{command_battery}{mode}{datetime}#[fg=#454545]| #[fg=#d9a35a,bold]{session} "
                format_space  ""
                // Keep the right-side context visible if unusually long tab
                // names collide with it on a narrow terminal.
                format_hide_on_overlength "true"
                format_precedence         "rlc"

                // This is a local extension to pinned zjstatus 0.24.0. The
                // limit is measured in terminal display cells, not bytes.
                focused_pane_title_max_length "28"

                // Normal mode stays quiet. Other modes are short badges next
                // to the clock; Ctrl-Space ? remains the canonical help.
                mode_normal       ""
                mode_locked       "#[fg=#454545] | #[fg=#e08585,bold]PASSTHROUGH"
                mode_tmux         "#[fg=#454545] | #[fg=#d9a35a,bold]COMMANDS"
                mode_pane         "#[fg=#454545] | #[fg=#d9a35a,bold]PANE"
                mode_tab          "#[fg=#454545] | #[fg=#d9a35a,bold]TAB"
                mode_session      "#[fg=#454545] | #[fg=#d9a35a,bold]SESSION"
                mode_resize       "#[fg=#454545] | #[fg=#d9a35a,bold]RESIZE"
                mode_scroll       "#[fg=#454545] | #[fg=#d9a35a,bold]SCROLL"
                mode_enter_search "#[fg=#454545] | #[fg=#d9a35a,bold]SEARCH"
                mode_search       "#[fg=#454545] | #[fg=#d9a35a,bold]SEARCH"
                mode_rename_tab   "#[fg=#454545] | #[fg=#d9a35a,bold]RENAME TAB"
                mode_rename_pane  "#[fg=#454545] | #[fg=#d9a35a,bold]RENAME PANE"
                mode_move         "#[fg=#454545] | #[fg=#d9a35a,bold]GIT"
                mode_prompt       "#[fg=#454545] | #[fg=#d9a35a,bold]PROMPT"
                tab_normal   "#[fg=#c7c7c7] {index}:{name}{fullscreen_indicator}{sync_indicator}{bell_indicator} "
                tab_active   "#[fg=#d9a35a,bold] {index}:{name}{fullscreen_indicator}{sync_indicator}{bell_indicator} "
                tab_normal_bell "#[fg=#e19067,bold] {index}:{name}{fullscreen_indicator}{sync_indicator}{bell_indicator} "
                tab_normal_flashing_bell "#[bg=#e19067,fg=#151515,bold] {index}:{name}{fullscreen_indicator}{sync_indicator}{bell_indicator} #[bg=#151515]"
                tab_fullscreen_indicator " #[fg=#e19067]FULL"
                tab_sync_indicator       " #[fg=#8c9cb8]SYNC"
                // A quiet orange dot keeps acknowledged attention visible;
                // the ringing bell is reserved for the active flash state.
                tab_bell_indicator       " #[fg=#e19067,bold]●"
                tab_flashing_bell_indicator " #[fg=#151515,bold]󰂠"

                command_battery_command           "@zellijBatteryCommand@"
                command_battery_format            "#[fg=#454545] | #[fg=#d9a35a]{stdout}"
                command_battery_interval          "30"
                command_battery_rendermode        "static"
                command_battery_hideonemptystdout "true"

                datetime          "#[fg=#454545] | #[fg=#9eb38e]{format} "
                datetime_format   "%a %d %b  %H:%M"
                datetime_timezone "Europe/Berlin"
            }
        }
        children;
    }

    tab { pane; }

    // Explicit whole-tab normalizer: equal-width vertical lanes with panes
    // stacked top-to-bottom inside each lane. Normal pane creation and closure
    // preserve the manual split topology. exact_panes includes zjstatus.
    swap_tiled_layout name="lanes" {
        // 2 terminals: [1, 1]
        tab exact_panes=3 {
            pane split_direction="vertical" {
                pane
                pane
            }
        }

        // 3 terminals: [1, 2]
        tab exact_panes=4 {
            pane split_direction="vertical" {
                pane
                pane split_direction="horizontal" {
                    pane
                    pane
                }
            }
        }

        // 4 terminals: [2, 2]
        tab exact_panes=5 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                }
            }
        }

        // 5 terminals: [2, 3]
        tab exact_panes=6 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
            }
        }

        // 6 terminals: [3, 3]
        tab exact_panes=7 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
            }
        }

        // 7 terminals: [2, 2, 3]
        tab exact_panes=8 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
            }
        }

        // 8 terminals: [2, 3, 3]
        tab exact_panes=9 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
            }
        }

        // 9 terminals: [3, 3, 3]
        tab exact_panes=10 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
            }
        }

        // 10 terminals: [3, 3, 4]
        tab exact_panes=11 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }

        // 11+ terminals: keep three lanes and grow the left one as needed.
        tab min_panes=12 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" { children; }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
    }

    swap_floating_layout name="staggered" {
        floating_panes
    }

    swap_floating_layout name="enlarged" {
        floating_panes max_panes=10 {
            pane { x "5%"; y 1; width "90%"; height "90%"; }
            pane { x "5%"; y 2; width "90%"; height "90%"; }
            pane { x "5%"; y 3; width "90%"; height "90%"; }
            pane { x "5%"; y 4; width "90%"; height "90%"; }
            pane { x "5%"; y 5; width "90%"; height "90%"; }
            pane { x "5%"; y 6; width "90%"; height "90%"; }
            pane { x "5%"; y 7; width "90%"; height "90%"; }
            pane { x "5%"; y 8; width "90%"; height "90%"; }
            pane { x "5%"; y 9; width "90%"; height "90%"; }
            pane { x 10; y 10; width "90%"; height "90%"; }
        }
    }

    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane { y "50%"; x "50%"; }
        }
        floating_panes max_panes=2 {
            pane { x "1%"; y "25%"; width "45%"; }
            pane { x "50%"; y "25%"; width "45%"; }
        }
        floating_panes max_panes=3 {
            pane { y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; }
            pane { x "50%"; y "1%"; width "45%"; }
        }
        floating_panes max_panes=4 {
            pane { x "1%"; y "55%"; width "45%"; height "45%"; }
            pane { x "50%"; y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; height "45%"; }
            pane { x "50%"; y "1%"; width "45%"; height "45%"; }
        }
    }
}
