// Gruvbox Night: warm hard-dark surfaces with a clear orange focus accent.
// The palette mirrors modules/theme/gruvbox-night.nix. Syntax and status hues
// stay distinct while selected tabs, rows, and pane frames share one signal.
themes {
    gruvbox-night {
        text_unselected {
            base 208 192 160
            background 29 32 33
            emphasis_0 213 138 84
            emphasis_1 132 169 178
            emphasis_2 163 173 98
            emphasis_3 195 141 160
        }
        text_selected {
            base 213 138 84
            background 59 42 34
            emphasis_0 219 126 117
            emphasis_1 132 169 178
            emphasis_2 163 173 98
            emphasis_3 195 141 160
        }
        ribbon_selected {
            base 29 32 33
            background 213 138 84
            emphasis_0 219 126 117
            emphasis_1 201 162 87
            emphasis_2 195 141 160
            emphasis_3 163 173 98
        }
        ribbon_unselected {
            base 208 192 160
            background 40 40 40
            emphasis_0 219 126 117
            emphasis_1 223 207 170
            emphasis_2 132 169 178
            emphasis_3 195 141 160
        }
        table_title {
            base 132 169 178
            background 29 32 33
            emphasis_0 213 138 84
            emphasis_1 201 162 87
            emphasis_2 163 173 98
            emphasis_3 195 141 160
        }
        table_cell_selected {
            base 213 138 84
            background 59 42 34
            emphasis_0 219 126 117
            emphasis_1 132 169 178
            emphasis_2 163 173 98
            emphasis_3 195 141 160
        }
        table_cell_unselected {
            base 208 192 160
            background 29 32 33
            emphasis_0 213 138 84
            emphasis_1 132 169 178
            emphasis_2 163 173 98
            emphasis_3 195 141 160
        }
        list_selected {
            base 213 138 84
            background 59 42 34
            emphasis_0 219 126 117
            emphasis_1 132 169 178
            emphasis_2 163 173 98
            emphasis_3 195 141 160
        }
        list_unselected {
            base 208 192 160
            background 29 32 33
            emphasis_0 213 138 84
            emphasis_1 132 169 178
            emphasis_2 163 173 98
            emphasis_3 195 141 160
        }
        frame_unselected {
            base 124 111 100
            background 29 32 33
            emphasis_0 213 138 84
            emphasis_1 132 169 178
            emphasis_2 195 141 160
            emphasis_3 29 32 33
        }
        frame_selected {
            base 213 138 84
            background 29 32 33
            emphasis_0 219 126 117
            emphasis_1 132 169 178
            emphasis_2 195 141 160
            emphasis_3 29 32 33
        }
        frame_highlight {
            // Hover stays neutral so orange is reserved for keyboard focus.
            base 124 111 100
            background 29 32 33
            emphasis_0 195 141 160
            emphasis_1 213 138 84
            emphasis_2 201 162 87
            emphasis_3 132 169 178
        }
        exit_code_success {
            base 163 173 98
            background 29 32 33
            emphasis_0 127 169 138
            emphasis_1 60 56 54
            emphasis_2 195 141 160
            emphasis_3 132 169 178
        }
        exit_code_error {
            base 219 126 117
            background 29 32 33
            emphasis_0 201 162 87
            emphasis_1 29 32 33
            emphasis_2 29 32 33
            emphasis_3 29 32 33
        }
        multiplayer_user_colors {
            player_1 195 141 160
            player_2 132 169 178
            player_3 127 169 138
            player_4 201 162 87
            player_5 163 173 98
            player_6 213 138 84
            player_7 219 126 117
            player_8 156 141 125
            player_9 223 207 170
            player_10 185 145 107
        }
    }
}
