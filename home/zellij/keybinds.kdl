keybinds clear-defaults=true {
    // Normal is deliberately close to pass-through. Ctrl-Space opens the
    // tmux-compatible prefix mode and Ctrl-g is the true locked mode.
    normal {
        bind "Ctrl h" {
            MessagePlugin "vim-zellij-navigator" {
                name "move_focus"
                payload "left"
            }
        }
        bind "Ctrl j" {
            MessagePlugin "vim-zellij-navigator" {
                name "move_focus"
                payload "down"
            }
        }
        bind "Ctrl k" {
            MessagePlugin "vim-zellij-navigator" {
                name "move_focus"
                payload "up"
            }
        }
        bind "Ctrl l" {
            MessagePlugin "vim-zellij-navigator" {
                name "move_focus"
                payload "right"
            }
        }
        bind "Alt h" { GoToPreviousTab; }
        bind "Alt l" { GoToNextTab; }
        bind "Super 1" { GoToTab 1; }
        bind "Ctrl Shift 1" { GoToTab 1; }
        bind "Super 2" { GoToTab 2; }
        bind "Ctrl Shift 2" { GoToTab 2; }
        bind "Super 3" { GoToTab 3; }
        bind "Ctrl Shift 3" { GoToTab 3; }
        bind "Super 4" { GoToTab 4; }
        bind "Ctrl Shift 4" { GoToTab 4; }
        bind "Super 5" { GoToTab 5; }
        bind "Ctrl Shift 5" { GoToTab 5; }
        bind "Super 6" { GoToTab 6; }
        bind "Ctrl Shift 6" { GoToTab 6; }
        bind "Super 7" { GoToTab 7; }
        bind "Ctrl Shift 7" { GoToTab 7; }
        bind "Super 8" { GoToTab 8; }
        bind "Ctrl Shift 8" { GoToTab 8; }
        bind "Super 9" { GoToTab 9; }
        bind "Ctrl Shift 9" { GoToTab 9; }
    }

    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    tmux {
        bind "Ctrl Space" { Write 0; SwitchToMode "Normal"; }
        // Preserve an explicit clear-screen path now that bare Ctrl-l moves
        // right in Normal mode.
        bind "Ctrl l" { Write 12; SwitchToMode "Normal"; }

        bind "p" { SwitchToMode "Pane"; }
        bind "w" { SwitchToMode "Tab"; }
        bind "s" { SwitchToMode "Session"; }
        bind "[" { SwitchToMode "Scroll"; }

        bind "c" {
            NewTab {
                layout "lanes"
            }
            SwitchToMode "Normal"
        }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "N" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind ";" { FocusPreviousPane; SwitchToMode "Normal"; }
        // Match the tmux split model: `|` creates a pane to the right and `-`
        // creates one below the focused pane. Directional splits keep manual
        // lane ownership intact instead of invoking the automatic layout.
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }
        // With one tiled swap family this normalizes any manual split or
        // resize back to the canonical vertical-lane layout.
        bind "Space" { NextSwapLayout; SwitchToMode "Normal"; }
        bind "m" { ToggleMouseMode; SwitchToMode "Normal"; }
        bind "t" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "d" { Detach; }

        bind "S" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
                vim_mode true
            }
            SwitchToMode "Normal"
        }
        bind "P" {
            Run "zellij-project-picker" {
                floating true
                close_on_exit true
                x "10%"
                y "20%"
                width "80%"
                height "60%"
                name "projects"
            }
            SwitchToMode "Normal"
        }
        bind "T" {
            LaunchOrFocusPlugin "zextract" {
                floating true
                move_to_focused_tab true
                grab "quick"
                popupTitle "extract"
            }
            SwitchToMode "Normal"
        }
        // Move is the one stable, otherwise-unused mode available for the
        // tmux-style Git submenu.
        bind "g" { SwitchToMode "Move"; }
        bind "?" {
            Run "zellij-keymap-help" {
                floating true
                close_on_exit true
                x "5%"
                y "5%"
                width "90%"
                height "90%"
                name "keys"
                borderless true
            }
            SwitchToMode "Normal"
        }
    }

    // Stable spare mode used as the tmux `g` submenu.
    move {
        bind "g" {
            Run "lazygit" {
                floating true
                close_on_exit true
                x "5%"
                y "5%"
                width "90%"
                height "90%"
                name "lazygit"
            }
            SwitchToMode "Normal"
        }
        bind "s" {
            Run "git" "status" {
                floating true
                close_on_exit false
                x "10%"
                y "10%"
                width "80%"
                height "80%"
                name "git status"
            }
            SwitchToMode "Normal"
        }
        bind "l" {
            Run "git" "--no-pager" "log" "--oneline" "--graph" "-20" {
                floating true
                close_on_exit false
                x "10%"
                y "10%"
                width "80%"
                height "80%"
                name "git log"
            }
            SwitchToMode "Normal"
        }
        bind "d" {
            Run "git" "--no-pager" "diff" {
                floating true
                close_on_exit false
                x "10%"
                y "10%"
                width "80%"
                height "80%"
                name "git diff"
            }
            SwitchToMode "Normal"
        }
    }

    pane {
        bind "h" { MoveFocus "Left"; }
        bind "j" { MoveFocus "Down"; }
        bind "k" { MoveFocus "Up"; }
        bind "l" { MoveFocus "Right"; }
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        // Pane groups are Zellij's closest native equivalent to tmux marks.
        bind "m" { TogglePaneInGroup; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "Resize"; }
        bind "L" { NextSwapLayout; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "R" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "i" { TogglePanePinned; SwitchToMode "Normal"; }
    }

    resize {
        bind "h" { Resize "Increase Left"; }
        bind "j" { Resize "Increase Down"; }
        bind "k" { Resize "Increase Up"; }
        bind "l" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    tab {
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "h" { GoToPreviousTab; }
        bind "j" { GoToNextTab; }
        bind "n" {
            NewTab {
                layout "lanes"
            }
            SwitchToMode "Normal"
        }
        bind "k" { CloseTab; SwitchToMode "Normal"; }
        bind "l" {
            // multi_screen exposes the session -> tab -> pane hierarchy. A
            // fresh instance avoids reusing the session-only manager.
            LaunchPlugin "zellij:session-manager" {
                floating true
                multi_screen true
            }
            SwitchToMode "Normal"
        }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "<" { MoveTab "Left"; SwitchToMode "Normal"; }
        bind ">" { MoveTab "Right"; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; }
    }

    session {
        bind "d" { Detach; }
        // The native manager supplies safe create, rename, switch, and kill
        // flows where core key actions would require hard-coded names.
        bind "s" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
                vim_mode true
            }
            SwitchToMode "Normal"
        }
        bind "c" {
            LaunchOrFocusPlugin "zellij:configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        bind "p" {
            LaunchOrFocusPlugin "zellij:plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        // Competing whole-session layouts are intentionally not exposed.
    }

    scroll {
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "Ctrl f" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        // Zellij has no native keyboard selection cursor. Open the scrollback
        // in Neovim, where v/V/C-v select and y copies through unnamedplus.
        bind "v" { EditScrollback; SwitchToMode "Normal"; }
    }

    entersearch {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    search {
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "Ctrl f" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    renametab {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
    }

    renamepane {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
    }

    shared_except "normal" "locked" "entersearch" {
        bind "Enter" "Esc" { SwitchToMode "Normal"; }
    }
    shared_except "tmux" "locked" {
        bind "Ctrl Space" { SwitchToMode "Tmux"; }
    }
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "Locked"; }
    }
}
