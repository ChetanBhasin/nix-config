diff --git a/src/widgets/focused_pane_title.rs b/src/widgets/focused_pane_title.rs
new file mode 100644
index 0000000..6651c8a
--- /dev/null
+++ b/src/widgets/focused_pane_title.rs
@@ -0,0 +1,96 @@
+use std::collections::BTreeMap;
+
+use crate::{config::ZellijState, widgets::widget::Widget};
+
+const DEFAULT_MAX_LENGTH: usize = 28;
+
+pub struct FocusedPaneTitleWidget {
+    max_length: usize,
+}
+
+impl FocusedPaneTitleWidget {
+    pub fn new(config: &BTreeMap<String, String>) -> Self {
+        let max_length = config
+            .get("focused_pane_title_max_length")
+            .and_then(|value| value.parse::<usize>().ok())
+            .filter(|value| *value > 0)
+            .unwrap_or(DEFAULT_MAX_LENGTH);
+
+        Self { max_length }
+    }
+}
+
+impl Widget for FocusedPaneTitleWidget {
+    fn process(&self, _name: &str, state: &ZellijState) -> String {
+        let title = state
+            .tabs
+            .iter()
+            .find(|tab| tab.active)
+            .and_then(|tab| state.panes.panes.get(&tab.position))
+            .and_then(|panes| panes.iter().find(|pane| pane.is_focused))
+            .map(|pane| pane.title.as_str())
+            .unwrap_or_default();
+
+        console::truncate_str(title, self.max_length, "…").into_owned()
+    }
+
+    fn process_click(&self, _name: &str, _state: &ZellijState, _pos: usize) {}
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use zellij_tile::prelude::{PaneInfo, PaneManifest, TabInfo};
+
+    fn state_with_title(title: &str) -> ZellijState {
+        let tab = TabInfo {
+            active: true,
+            position: 2,
+            ..TabInfo::default()
+        };
+        let pane = PaneInfo {
+            is_focused: true,
+            title: title.to_owned(),
+            ..PaneInfo::default()
+        };
+        let mut panes = PaneManifest::default();
+        panes.panes.insert(tab.position, vec![pane]);
+
+        ZellijState {
+            tabs: vec![tab],
+            panes,
+            ..ZellijState::default()
+        }
+    }
+
+    #[test]
+    fn renders_the_focused_pane_in_the_active_tab() {
+        let widget = FocusedPaneTitleWidget::new(&BTreeMap::new());
+
+        assert_eq!(
+            widget.process("focused_pane_title", &state_with_title("editor")),
+            "editor"
+        );
+    }
+
+    #[test]
+    fn truncates_to_the_configured_display_width() {
+        let config = BTreeMap::from([("focused_pane_title_max_length".to_owned(), "8".to_owned())]);
+        let widget = FocusedPaneTitleWidget::new(&config);
+
+        assert_eq!(
+            widget.process("focused_pane_title", &state_with_title("a very long title")),
+            "a very …"
+        );
+    }
+
+    #[test]
+    fn renders_empty_without_an_active_focused_pane() {
+        let widget = FocusedPaneTitleWidget::new(&BTreeMap::new());
+
+        assert_eq!(
+            widget.process("focused_pane_title", &ZellijState::default()),
+            ""
+        );
+    }
+}
